FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 HF_HUB_OFFLINE=1
COPY requirements.txt requirements-vision.txt ./
RUN pip install --no-cache-dir torch==2.9.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-vision.txt
COPY visionpatch ./visionpatch
COPY reports/visionpatch ./reports/visionpatch
COPY output/visionpatch/figures ./output/visionpatch/figures
COPY output/visionpatch/study-v2 ./output/visionpatch/study-v2
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/runtime/visionpatch/workbench \
    && chown -R appuser:appuser /app/runtime
USER appuser
EXPOSE 8002
CMD ["python", "-m", "uvicorn", "visionpatch.app:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
